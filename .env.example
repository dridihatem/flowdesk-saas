APP_NAME="Flowqil"

# Product brand (logo, auth sidebar, marketing)
FLOWDESK_BRAND_NAME=Flowqil
FLOWDESK_BRAND_TAGLINE="The brain that flows with your voice."

# Central platform administrator (optional seed via PlatformAdminSeeder)
FLOWDESK_PLATFORM_ADMIN_EMAIL=platform@demo.local
FLOWDESK_PLATFORM_ADMIN_PASSWORD=password

# After `php artisan db:seed`: demo users share password `password` —
# admin@demo.local (company_admin), team@demo.local (team_member), provider@demo.local (business_provider), test@example.com (admin)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8888

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=flowdesksaas
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use .yourdomain.com for wildcard subdomains (shared session across app + tenants)
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue: `sync` sends mail and other queued jobs in-process (simplest for local dev).
# `database` or `redis` requires `php artisan queue:work` (or Horizon) for outbound mail,
# because partnership invites, invoice sends, and campaign messages implement ShouldQueue.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# `log` only writes to storage/logs (no inbox). For real delivery set a transport:
#   SMTP:     MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
#   Resend:   MAIL_MAILER=resend, RESEND_API_KEY= (see config/services.php)
#   Postmark: MAIL_MAILER=postmark, POSTMARK_API_KEY=
# Local catch-all (e.g. Mailpit): MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025, MAIL_ENCRYPTION=null
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# RESEND_API_KEY=
# POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated Host headers treated as the central (non-tenant) app
FLOWDESK_CENTRAL_DOMAINS=127.0.0.1,localhost

# e.g. flowdesk-saas.com — first label becomes tenant subdomain (null for local-only)
FLOWDESK_TENANT_BASE_DOMAIN=

# New workspace free trial (days + plan slug used during trial)
FLOWDESK_TRIAL_DAYS=14
FLOWDESK_TRIAL_PLAN_SLUG=pro

# Auto-detect UI language from visitor IP (ip-api.com). Set false in local/tests.
FLOWDESK_IP_LOCALE_LOOKUP=true

# Project attachments (per-file max KB, total storage MB per project, thumbnail width)
# FLOWDESK_PROJECT_MAX_FILE_KB=12288
# FLOWDESK_PROJECT_MAX_STORAGE_MB=512
# FLOWDESK_PROJECT_THUMB_MAX_WIDTH=360

# AI credits are charged per task (see config/flowdesk.php → ai_task_credits)
# Landing page visual builder (GrapesJS) — disabled by default until stable
# FLOWDESK_LANDING_PAGE_WRITING_MODE=false
# Example: report counsel = 100, project example workspace = 250

# Laravel Socialite — set redirect URIs to {APP_URL}/auth/{provider}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Optional: tenant Google Calendar (same OAuth client; add this URL in Google Cloud as an authorized redirect URI and enable Google Calendar API)
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/settings/google-calendar/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

# Error monitoring (optional — leave empty to disable)
SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Spatie backup — disk name from config/filesystems.php (e.g. local, s3)
BACKUP_DISK=local
# Optional zip encryption
# BACKUP_ARCHIVE_PASSWORD=

